{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Faqs": [
    {
      "keyword": "how to",
      "response": "Here's a guide on how to do that: [link]"
    },
    {
      "keyword": "what is",
      "response": "This is what it means: [explanation]"
    },
    {
      "keyword": "help",
      "response": "How can I assist you today?"
    },
    {
      "keyword": "faq",
      "response": "Check out our FAQ page: [link]"
    }
  ],

  "integration": [
    {
      "data": {
        "date": {
          "created_at": "2024-10-27",
          "updated_at": "2024-10-27"
        },
        "descriptions": {
          "app_description": "Answers frequently asked questions.",
          "app_logo": "",
          "app_name": "FAQ Bot",
          "app_url": "",
          "background_color": "#FFFFFF"
        },
        "integration_category": "IT Service Management",
        "integration_type": "modifier",
        "is_active": true,
        "output": [],
        "key_features": [ "Answers FAQs" ],
        "permissions": {},
        "settings": [
          {
            "label": "FAQ Data",
            "type": "text_area",
            "required": true,
            "default": "[{\"question\": \"What is your return policy?\", \"answer\": \"Our return policy is 30 days.\"}]"
          },
          {
            "label": "Similarity Threshold",
            "type": "number",
            "required": true,
            "default": "0.8"
          }
        ],
        "target_url": "YOUR_TARGET_URL_HERE/faqbot"
      }
    }
  ]
}
